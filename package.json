{
  "name": "mern",
  "version": "1.0.0",
  "description": "Job Tracker",
  "main": "server.js",
  "scripts": {
    "server": "node server.js",
    "client": "cd client && npm run start",
    "start": "concurrently \"node --watch-path=server.js --watch-path=routes --watch-path=models --watch-path=shared --watch-path=passport.js server.js\" \"npm run client\"",
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "mongoose": "^9.11.2",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
